		compatible = "sprd,power-debug-sharkl5pro";
		sprd,enable = <0x01>;
		sprd,scan-interval = <0x1e>;
		sprd,sys-ap-ahb = <0x26>;
		sprd,sys-ap-apb = <0x20>;
		sprd,sys-pmu-apb = <0x02>;
		sprd,sys-aon-apb = <0x0b>;
		sprd,sys-ap-intc = <0xc8 0xc9 0xca 0xcb 0xcc 0xcd>;
		phandle = <0x159>;
	};

