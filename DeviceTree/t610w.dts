	qos {
		#address-cells = <0x01>;
		#size-cells = <0x00>;
		ranges;

		qos@0 {
			reg = <0x00>;
			arqos = [06];
			awqos = [06];
			arqos-threshold = [0f];
			awqos-threshold = [0f];
			phandle = <0x1b>;
		};

		qos@1 {
			reg = <0x01>;
			awqos-high = [0a];
			awqos-low = [0a];
			arqos-high = [0d];
			arqos-low = [0c];
			arqos-threshold = [0c];
			awqos-threshold = [0f];
			phandle = <0x28>;
		};

		qos@2 {
			reg = <0x02>;
			awqos = [01];
			arqos-high = [07];
			arqos-low = [01];
			phandle = <0x30>;
		};

		mm {

			qos@0 {
				reg = <0x00>;
				arqos = [0a];
				awqos-high = [0d];
				awqos-low = [0c];
				phandle = <0x13>;
			};

			qos@1 {
				reg = <0x01>;
				awqos-high = [07];
				awqos-low = [06];
				arqos-high = [07];
				arqos-low = [06];
				phandle = <0x0a>;
			};

			qos@2 {
				reg = <0x02>;
				awrqos = [01];
				phandle = <0x10>;
			};

			qos@3 {
				reg = <0x03>;
				arqos = [01];
				awqos = [01];
				phandle = <0x15>;
			};

			qos@4 {
				reg = <0x04>;
				arqos-high = [07];
				arqos-low = [01];
				awqos = [01];
				phandle = <0x0e>;
			};

			qos@5 {
				reg = <0x05>;
				arqos-threshold = [06];
				awqos-threshold = [06];
				phandle = <0x08>;
			};
		};

		vdsp {

			qos@0 {
				reg = <0x00>;
				arqos-vdsp-msti = [06];
				arqos-vdsp-mstd = [06];
				awqos-vdsp-mstd = [06];
				arqos-vdsp-idma = [01];
				awqos-vdsp-idma = [01];
				arqos-vdma = [01];
